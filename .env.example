NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Assistant backend - server only, never expose in frontend code
OPENAI_API_KEY=
ASSISTANT_MODEL=gpt-4o-mini
ASSISTANT_BACKEND=hermes
ASSISTANT_OPENAI_FALLBACK=false
ASSISTANT_SINGLE_OPERATOR_MODE=false
# Server-side local archive context for dashboard assistant.
# Keep disabled by default; enable only in trusted local/private deployments.
ASSISTANT_LOCAL_ARCHIVE=false
HERMES_STATE_DB_PATH=~/.hermes/state.db
OBSIDIAN_VAULT_PATH=~/Your Obsidian Vault
HERMES_CLI_PATH=/usr/local/lib/hermes-agent/venv/bin/hermes
# Optional for hosted environments that cannot run the Hermes CLI directly:
# HERMES_API_BASE_URL=https://your-hermes-bridge.example.com/v1
# HERMES_API_KEY=
# HERMES_API_MODEL=hermes-agent
ASSISTANT_ALLOWED_EMAILS=
FIREBASE_SERVICE_ACCOUNT_KEY=

# Optional private hosted dashboard gate. Set server-side only.
# Opening /?access_token=<token> once stores a private httpOnly cookie.
DASHBOARD_ACCESS_TOKEN=
